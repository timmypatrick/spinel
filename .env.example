# -----------------------------------------------------------------
# Spinel Distribution Ltd - Vercel Environment Variables
# Configure these environment variables in your Vercel Project Settings
# -----------------------------------------------------------------

# 1. Gemini AI API Key (Server-side)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Supabase Configuration (Database & Authentication)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# 3. Paystack Payment Gateway Integration
PAYSTACK_SECRET_KEY="sk_live_or_test_your_paystack_secret_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_or_test_your_paystack_public_key"

# 4. Host Application URL
APP_URL="https://your-app.vercel.app"
