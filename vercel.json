{
  "version": 2,
  "builds": [{
    "src": "server.ts",
    "use": "@vercel/node"
  }],

  "routes": [{
    "src": "/(.*)",
    "dest": "server.ts"
  }],

  "cleanUrls": true,
  
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
